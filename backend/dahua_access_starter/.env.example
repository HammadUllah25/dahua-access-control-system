# Application database. SQLite is for one-machine development only.
# For a central cloud database, use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://access_user:CHANGE_ME@db-host:5432/dahua_access
DATABASE_URL=sqlite:///./data/dahua_access.db

# Device passwords are encrypted before storage. In cloud deployments, set the
# same persistent Fernet key on every backend/worker from a secret manager.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEVICE_ENCRYPTION_KEY=PASTE_GENERATED_KEY_HERE

APP_NAME=Dahua Access Control API
DATA_DIR=./data

# Device health monitor defaults
DEVICE_MONITOR_INTERVAL_SECONDS=10
DEVICE_MONITOR_TCP_TIMEOUT_SECONDS=1.5
DEVICE_MONITOR_FAILURE_THRESHOLD=2
DEVICE_MONITOR_RECONNECT_COOLDOWN_SECONDS=30
DEVICE_MONITOR_MAX_WORKERS=32

# Dahua CGI configuration port used for door-parameter read/write (commonly 80)
DAHUA_HTTP_PORT=80

#remote unlock api

# REMOTE_UNLOCK_API_KEY=wuOJu4MKFGdp9MMES8ie45dFItRrSeDEoqqBRM7TG20

# REMOTE_UNLOCK_API_KEY=MySecureUnlockKey2026_Test

# Safepay Raast Dynamic QR (SANDBOX)
SAFEPAY_ENV=sandbox
SAFEPAY_HOST=https://sandbox.api.getsafepay.com
SAFEPAY_SECRET_KEY=
SAFEPAY_MERCHANT_API_KEY=
SAFEPAY_TIMEOUT_SECONDS=15

# PKR 1.00 = 100 minor units
PAYMENT_ENTRY_FEE_MINOR=100
PAYMENT_QR_TTL_MINUTES=5

# Enable only for local sandbox testing with the physical Dahua device.
# This does NOT simulate a Safepay confirmation; it tests the door-unlock pipeline only.
SAFEPAY_ENABLE_TEST_SIMULATOR=false

# Customer-facing payment kiosk. Enable only on the dedicated kiosk network.
KIOSK_PUBLIC_ENABLED=false
KIOSK_STATION_ID=1
# Leave blank only when this station has exactly one controller.
KIOSK_DEVICE_ID=1
KIOSK_DOOR_INDEX=0
# Restrict kiosk page and QR creation to localhost plus your actual LAN subnet.
# Example for a 192.168.0.x LAN: 127.0.0.1/32,::1/128,192.168.0.0/24
KIOSK_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
