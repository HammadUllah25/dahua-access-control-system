# Application database. SQLite is for one-machine development only.
# For a central cloud database, use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://access_user:CHANGE_ME@db-host:5432/dahua_access
DATABASE_URL=sqlite:///./data/dahua_access.db

# Device passwords are encrypted before storage. In cloud deployments, set the
# same persistent Fernet key on every backend/worker from a secret manager.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEVICE_ENCRYPTION_KEY=PASTE_GENERATED_KEY_HERE

APP_NAME=Dahua Access Control API
DATA_DIR=./data

# Device health monitor defaults
DEVICE_MONITOR_INTERVAL_SECONDS=10
DEVICE_MONITOR_TCP_TIMEOUT_SECONDS=1.5
DEVICE_MONITOR_FAILURE_THRESHOLD=2
DEVICE_MONITOR_RECONNECT_COOLDOWN_SECONDS=30
DEVICE_MONITOR_MAX_WORKERS=32

# Dahua CGI configuration port used for door-parameter read/write (commonly 80)
DAHUA_HTTP_PORT=80
